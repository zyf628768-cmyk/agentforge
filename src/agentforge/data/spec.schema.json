{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["name", "version", "goal", "kind", "inputs", "outputs", "dependencies", "steps", "risks", "acceptance", "test_plan", "options"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "kind": {"enum": ["text-cleaner", "wasm-json", "python-json"]},
    "goal": {"type": "string", "minLength": 1, "maxLength": 4000},
    "inputs": {"type": "object"}, "outputs": {"type": "object"},
    "dependencies": {"type": "array", "maxItems": 0},
    "steps": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "test_plan": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "options": {"type": "object"}
  },
  "allOf": [{
    "if": {"properties": {"kind": {"const": "text-cleaner"}}},
    "then": {"properties": {"options": {"type": "object", "additionalProperties": false, "required": ["preserve_case"], "properties": {"preserve_case": {"const": true}}}}},
    "else": {"properties": {"options": {"type": "object", "maxProperties": 0}}}
  }]
}
