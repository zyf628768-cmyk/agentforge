+package systrap
+
+import (
+	"errors"
+	"fmt"
+	"testing"
+
+	"golang.org/x/sys/unix"
+)
+
+func TestStubResourceErrnoSurvivesRequest(t *testing.T) {
+	for _, errno := range []unix.Errno{unix.EAGAIN, unix.ENOMEM} {
+		s := &subprocess{requests: make(chan any)}
+		go func() {
+			r := (<-s.requests).(requestStub)
+			if !r.replyResourceError(fmt.Errorf("creating stub process: %w", errno)) {
+				r.err <- errors.New("resource error was not classified")
+				r.done <- nil
+			}
+		}()
+		child, err := s.createStub()
+		got, ok := err.(unix.Errno)
+		if child != nil || !ok || got != errno {
+			t.Fatalf("createStub() = (%v, %T %v), want exact errno %v", child, err, err, errno)
+		}
+	}
+}
+
+func TestStubDoesNotReclassifyUnknownFailure(t *testing.T) {
+	r := requestStub{done: make(chan *thread, 1), err: make(chan error, 1)}
+	if r.replyResourceError(errors.New("unrelated internal failure")) {
+		t.Fatal("unknown failure was incorrectly classified as a resource denial")
+	}
+	if len(r.done) != 0 || len(r.err) != 0 {
+		t.Fatal("unknown failure must retain the original diagnostic path")
+	}
+}
