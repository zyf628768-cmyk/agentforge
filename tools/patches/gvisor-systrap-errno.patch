 // requestStub is used to request a new stub process.
 type requestStub struct {
 	done chan *thread
+	err  chan error
+}
+
+// replyResourceError preserves expected host resource failures for the guest.
+// Unknown failures keep the existing diagnostic path.
+func (r requestStub) replyResourceError(err error) bool {
+	var errno unix.Errno
+	switch {
+	case errors.Is(err, unix.EAGAIN):
+		errno = unix.EAGAIN
+	case errors.Is(err, unix.ENOMEM):
+		errno = unix.ENOMEM
+	default:
+		return false
+	}
+	r.err <- errno
+	r.done <- nil
+	return true
 }
 
